{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skillbright",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "dist/client",
  "observability": {
    "enabled": true
  }
}
